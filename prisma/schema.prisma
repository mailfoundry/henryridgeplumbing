generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model QuoteRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String
  address   String?
  message   String
  status    String   @default("new")   // new | contacted | quoted | completed
  createdAt DateTime @default(now())
}
